{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serial Monitor (miniterm)",
            "type": "shell",
            // Finds the first tty.usbmodem* port automatically -- survives replug port renames.
            // Uses pyserial-miniterm from the venv (works in Cursor; screen fails with "no PTY").
            // Exit: Ctrl+]
            "command": "PORT=$(ls /dev/tty.usbmodem* 2>/dev/null | head -1); if [ -z \"$PORT\" ]; then echo 'ERROR: No usbmodem device found. Is the board plugged in?'; else echo \"Connecting to $PORT at 115200 baud.\"; echo \"Exit: Ctrl+]\"; /Users/alex/Development/PythonVEs/CircuitPython_3.13_VsCode/bin/pyserial-miniterm --raw \"$PORT\" 115200; fi",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Serial Monitor: disconnect (kill miniterm)",
            "type": "shell",
            "command": "pkill -f pyserial-miniterm; echo 'miniterm process killed.'",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Sync Files to Board (dry-run)",
            "type": "shell",
            // Preview only, writes nothing. Copies .vscode/cpfiles.txt's active entries
            // (e.g. code_stage2.py -> /code.py) -- see scripts/sync_files_to_board.py.
            // Plain `python3` on purpose (stdlib-only script, no venv dependency needed --
            // keeps this task portable across checkouts, unlike the miniterm task above
            // which genuinely needs a specific venv's pyserial-miniterm).
            "command": "python3 \"${workspaceFolder}/scripts/sync_files_to_board.py\" --dry-run",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync Files to Board",
            "type": "shell",
            // Actually writes: copies .vscode/cpfiles.txt's active entries onto CIRCUITPY.
            "command": "python3 \"${workspaceFolder}/scripts/sync_files_to_board.py\"",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync Lib to Board (dry-run)",
            "type": "shell",
            // Preview only, writes nothing. Shows what would copy/skip-unchanged/exclude
            // under lib/ -- see scripts/sync_lib_to_board.py for the exclusion list.
            "command": "python3 \"${workspaceFolder}/scripts/sync_lib_to_board.py\" --dry-run",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync Lib to Board",
            "type": "shell",
            // Actually writes: copies the lib/ tree onto CIRCUITPY, skipping files whose
            // size/mtime already match (add --force to rewrite everything unconditionally).
            "command": "python3 \"${workspaceFolder}/scripts/sync_lib_to_board.py\"",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
